      </span>
      <span>Clarity<small>SERVER</small></span>
    </a>
    <div class="nav-links">
      <a href="index.html">Главная</a>
      <a href="donate.html">Донат</a>
      <a href="discord.html">Discord</a>
      <a href="about.html">О сервере</a>
      <a href="social.html">Соцсети</a>
      <a href="history.html">История</a>
    </div>
    <div class="nav-actions">
      <a class="btn btn-primary btn-sm" href="https://t.me/clarityminecraft" target="_blank" rel="noopener">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M21.9 4.3 2.7 11.7c-1.2.5-1.2 1.2-.2 1.5l4.9 1.5 1.9 5.8c.2.6.4.8.8.8.4 0 .5-.2.8-.4l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.7c.3-1.3-.4-1.8-1.9-1.4ZM7.9 14.4l9.6-6c.5-.3.9-.1.6.2l-8.2 7.4-.3 3.2-1.7-4.8Z"/></svg>
        <span class="full">Telegram</span>
      </a>
      <button class="nav-burger" aria-label="Меню"><span></span></button>
    </div>
  </div>
</nav>

<div class="mobile-menu">
  <a href="index.html">Главная</a>
