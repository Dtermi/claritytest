<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Clarity — уютный Minecraft-сервер для дружного комьюнити</title>
<meta name="description" content="Clarity — современный Minecraft-сервер для дружного комьюнити. Минимализм, честный премиум-донат, регулярные ивенты."/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="icon" href="assets/logo.png"/>
<link rel="stylesheet" href="style.css"/>
<style>
  .hero{ padding:150px 0 70px; overflow:hidden; }
  .hero-inner{ text-align:center; position:relative; z-index:2; }
  .hero h1{
    font-size:clamp(50px,10vw,128px);
    line-height:.94; letter-spacing:-.02em;
    background:linear-gradient(180deg, #0a0a0a 0%, #2b2b2b 55%, #1a1a1a 100%);
    -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
    margin-bottom:16px;
  }
  .hero-sub{ font-size:17px; color:var(--ink-soft); max-width:560px; margin:0 auto 28px; }
  .hero-cta{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
  .hero-ip{ font-family:monospace; font-weight:700; }

  @media(max-width:640px){
    .hero{ padding:118px 0 48px; }
    .hero h1{ margin-bottom:12px; }
    .hero-sub{ margin-bottom:22px; }
  }

  .dune-scene{ position:absolute; inset:0; z-index:0; pointer-events:none; }
  .dune-layer{
    position:absolute; left:-10%; right:-10%;
    height:220px; border-radius:50%;
  }
  .dune-1{ bottom:-120px; background:radial-gradient(ellipse at 50% 50%, rgba(79,184,232,.35), transparent 70%); filter:blur(10px); }
  .dune-2{ bottom:-170px; background:radial-gradient(ellipse at 40% 50%, rgba(31,143,204,.28), transparent 70%); }

  .hero-stats{
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
    max-width:920px; margin:0 auto; position:relative; z-index:2;
    background:var(--line); border-radius:var(--r-lg); overflow:hidden;
    border:1px solid var(--line);
  }
  .hero-stat{ background:rgba(255,255,255,.7); backdrop-filter:blur(14px); padding:26px 14px; text-align:center; }
  .hero-stat b{ display:block; font-size:30px; font-weight:800; color:var(--olive-deep); }
  .hero-stat span{ font-size:12.5px; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.08em; }
  @media(max-width:700px){ .hero-stats{ grid-template-columns:repeat(2,1fr); } }

  .features-section{ padding:76px 0; }
  .biome-strip{
    display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:60px;
  }
  .biome-chip{
    display:inline-flex; align-items:center; gap:8px;
    background:#fff; border:1px solid var(--line); padding:9px 18px;
    border-radius:var(--r-pill); font-size:13.5px; font-weight:600; color:var(--ink-soft);
    transition:.25s;
  }
  .biome-chip:hover{ border-color:var(--sand-deep); color:var(--olive-deep); transform:translateY(-2px); box-shadow:var(--shadow-sm); }
  .biome-chip .sq{ width:8px; height:8px; border-radius:2px; }

  .explore-section{ padding:50px 0 80px; }
  .explore-grid{ display:flex; flex-wrap:wrap; justify-content:center; gap:22px; }
  .explore-card{
    display:flex; flex-direction:column; gap:14px;
    flex:0 1 calc((100% - 44px)/3);
    padding:30px; border-radius:var(--r-lg);
    background:linear-gradient(155deg, rgba(255,255,255,.85), rgba(253,249,239,.6));
    border:1px solid var(--line);
    transition:.4s var(--ease);
  }
  .explore-card:hover{ transform:translateY(-6px); border-color:var(--sand-deep); box-shadow:var(--shadow-lg); }
  .explore-card h3{ font-size:18px; }
  .explore-card p{ font-size:15px; color:var(--ink-soft); flex:1; }
  .explore-arrow{ display:inline-flex; align-items:center; gap:6px; font-size:13.5px; font-weight:700; color:var(--olive); }
  @media(max-width:960px){ .explore-card{ flex:0 1 calc((100% - 22px)/2); } }
  @media(max-width:640px){ .explore-card{ flex:0 1 100%; } }

  .why-band{
    position:relative; margin:0 0 -1px;
    background:linear-gradient(180deg, transparent, var(--bg-sand-2) 30%);
    padding-top:10px;
  }

  @media(max-width:640px){
    .features-section{ padding:48px 0; }
    .explore-section{ padding:36px 0 56px; }
    .explore-grid{ gap:14px; }
    .explore-card{ padding:22px; }
  }
</style>
</head>
