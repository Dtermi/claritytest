<!-- HERO -->
<header class="hero">
  <div class="dune-scene">
    <div class="dune-blob" style="width:420px;height:420px;top:60px;left:-140px;background:var(--sand);opacity:.28;"></div>
    <div class="dune-blob" style="width:360px;height:360px;top:120px;right:-120px;background:var(--olive);opacity:.10;"></div>
  </div>
  <div class="container hero-inner">
    <div class="eyebrow reveal"><span class="dot"></span>Сезон 1</div>
    <h1 class="reveal reveal-delay-1">CLARITY</h1>
    <p class="hero-sub reveal reveal-delay-2">Дом для игроков, которые любят проводить время вместе: исследовать мир, создавать масштабные проекты, заводить новых друзей и просто наслаждаться игрой.</p>
    <div class="hero-cta reveal reveal-delay-3">
      <a href="https://t.me/clarityminecraft" target="_blank" rel="noopener" class="btn btn-primary">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M21.9 4.3 2.7 11.7c-1.2.5-1.2 1.2-.2 1.5l4.9 1.5 1.9 5.8c.2.6.4.8.8.8.4 0 .5-.2.8-.4l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.1-14.7c.3-1.3-.4-1.8-1.9-1.4ZM7.9 14.4l9.6-6c.5-.3.9-.1.6.2l-8.2 7.4-.3 3.2-1.7-4.8Z"/></svg>
        Наш Telegram
      </a>
    </div>
  </div>
</header>

